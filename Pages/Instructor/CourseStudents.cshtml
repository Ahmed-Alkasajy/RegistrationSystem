@page
@model student_online_system.Pages.Instructor.CourseStudentsModel
@{
    ViewData["Title"] = "Course Students";
}

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h3 class="mb-3">Enrolled Students</h3>

        <div id="tableContainer">
            <p class="text-muted">Loading...</p>
        </div>

        <a href="/Instructor/MyCourses" class="btn btn-outline-light mt-3">Back</a>
    </div>
</div>

<script>
    const params = new URLSearchParams(window.location.search);
    const courseId = params.get('courseId');

    async function loadStudents() {
        const container = document.getElementById('tableContainer');
        if (!courseId) {
            container.innerHTML = '<p class="text-muted">No course selected.</p>';
            return;
        }

        const res = await fetch('/api/instructor/courses/' + courseId + '/students');
        const data = await res.json();

        if (data.length === 0) {
            container.innerHTML = '<p class="text-muted">No students enrolled.</p>';
            return;
        }

        container.innerHTML = `
            <table class="table table-hover">
                <thead>
                    <tr><th>Name</th><th>Email</th><th>Enroll Date</th></tr>
                </thead>
                <tbody>
                    ${data.map(s => `
                        <tr class="hover-option">
                            <td>${s.fullName}</td>
                            <td>${s.email}</td>
                            <td>${s.enrollDate}</td>
                        </tr>`).join('')}
                </tbody>
            </table>`;
    }

    loadStudents();
</script>
