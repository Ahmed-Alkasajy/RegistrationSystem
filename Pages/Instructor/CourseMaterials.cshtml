@page
@model student_online_system.Pages.Instructor.CourseMaterialsModel
@{
    ViewData["Title"] = "Course Materials";
}

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h3 class="mb-3">My Courses (Materials)</h3>

        <div id="tableContainer">
            <p class="text-muted">Loading...</p>
        </div>
    </div>
</div>

<script>
    async function loadCourses() {
        const res = await fetch('/api/instructor/courses');
        const data = await res.json();
        const container = document.getElementById('tableContainer');

        if (data.length === 0) {
            container.innerHTML = '<p class="text-muted">You are not assigned to any courses.</p>';
            return;
        }

        container.innerHTML = `
            <table class="table table-hover">
                <thead>
                    <tr><th>Code</th><th>Name</th><th>Department</th><th></th></tr>
                </thead>
                <tbody>
                    ${data.map(c => `
                        <tr class="hover-option">
                            <td>${c.courseCode}</td>
                            <td>${c.courseName}</td>
                            <td>${c.departmentName}</td>
                            <td><a class="btn btn-outline-primary btn-sm" href="/Instructor/Materials?courseId=${c.courseId}">Materials</a></td>
                        </tr>`).join('')}
                </tbody>
            </table>`;
    }

    loadCourses();
</script>
