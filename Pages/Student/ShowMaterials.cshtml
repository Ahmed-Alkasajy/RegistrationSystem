@page
@model student_online_system.Pages.Student.MaterialsModel
@{
    ViewData["Title"] = "Course Materials";
}

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h3 class="mb-3">Course Materials</h3>

        <div id="tableContainer">
            <p class="text-muted">Loading...</p>
        </div>

        <a href="/Student/MyCourses" class="btn btn-outline-light mt-3">Back</a>
    </div>
</div>

<script>
    const params = new URLSearchParams(window.location.search);
    const courseId = params.get('courseId');

    async function loadMaterials() {
        const container = document.getElementById('tableContainer');
        if (!courseId) {
            container.innerHTML = '<p class="text-muted">No course selected.</p>';
            return;
        }

        const res = await fetch('/api/student/materials/' + courseId);
        const data = await res.json();

        if (data.length === 0) {
            container.innerHTML = '<p class="text-muted">No materials available.</p>';
            return;
        }

        container.innerHTML = `
            <table class="table table-hover">
                <thead>
                    <tr><th>File Name</th><th>Upload Date</th><th></th></tr>
                </thead>
                <tbody>
                    ${data.map(m => `
                        <tr class="hover-option">
                            <td>${m.fileName}</td>
                            <td>${m.uploadDate}</td>
                            <td><a class="btn btn-outline-primary btn-sm" href="${m.filePath}" target="_blank">Download</a></td>
                        </tr>`).join('')}
                </tbody>
            </table>`;
    }

    loadMaterials();
</script>
