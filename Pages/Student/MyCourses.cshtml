@page
@model student_online_system.Pages.Student.MyCoursesModel
@{
    ViewData["Title"] = "My Courses";
}

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h3 class="mb-3">My Courses</h3>
        <div id="msgAlert" class="alert alert-info d-none"></div>
        <div id="errorAlert" class="alert alert-danger d-none"></div>

        <div id="tableContainer">
            <p class="text-muted">Loading...</p>
        </div>
    </div>
</div>

<script>
    async function loadCourses() {
        const res = await fetch('/api/student/courses');
        const data = await res.json();
        const container = document.getElementById('tableContainer');

        if (data.length === 0) {
            container.innerHTML = '<p class="text-muted">You are not enrolled in any courses yet.</p>';
            return;
        }

        container.innerHTML = `
            <table class="table table-hover">
                <thead>
                    <tr><th>Code</th><th>Name</th><th>Department</th><th></th><th></th></tr>
                </thead>
                <tbody>
                    ${data.map(c => `
                        <tr class="hover-option">
                            <td>${c.courseCode}</td>
                            <td>${c.courseName}</td>
                            <td>${c.departmentName}</td>
                            <td><button class="btn btn-danger btn-sm" onclick="dropCourse(${c.courseId})">Drop</button></td>
                            <td><a class="btn btn-outline-primary btn-sm" href="/Student/ShowMaterials?courseId=${c.courseId}">Materials</a></td>
                        </tr>`).join('')}
                </tbody>
            </table>`;
    }

    async function dropCourse(courseId) {
        const msg = document.getElementById('msgAlert');
        const err = document.getElementById('errorAlert');
        msg.classList.add('d-none');
        err.classList.add('d-none');

        const res = await fetch('/api/student/courses/' + courseId, { method: 'DELETE' });
        if (res.ok) {
            msg.textContent = 'Course dropped successfully.';
            msg.classList.remove('d-none');
            loadCourses();
        } else {
            const data = await res.json();
            err.textContent = data.error || 'Failed to drop course.';
            err.classList.remove('d-none');
        }
    }

    loadCourses();
</script>
