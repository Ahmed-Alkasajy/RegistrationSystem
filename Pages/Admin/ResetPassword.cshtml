@page
@model student_online_system.Pages.Admin.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="mb-1">Search Users</h4>
                <p class="text-muted mb-3">Search by email or full name</p>

                <form id="searchForm">
                    <div class="mb-3">
                        <label class="form-label">Search</label>
                        <input id="searchInput" class="form-control form-control-lg"
                               placeholder="example: @@gmail or name" required />
                    </div>
                    <button class="btn btn-danger btn-lg w-100" type="submit" id="searchBtn">Search</button>
                </form>

                <div id="searchMsg" class="alert alert-info mt-3 d-none"></div>
                <div id="searchErr" class="alert alert-danger mt-3 d-none"></div>
            </div>
        </div>

        <div id="resultsCard" class="card shadow-sm mt-3 d-none">
            <div class="card-body p-4">
                <h5 class="mb-3">Results</h5>
                <table class="table table-hover">
                    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th></th></tr></thead>
                    <tbody id="usersTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="mb-1">Reset Password</h4>
                <p class="text-muted mb-3">Admin-only action</p>

                <div id="selectedInfo" class="d-none">
                    <div id="selectedAlert" class="alert alert-secondary"></div>
                    <div id="resetSuccess" class="alert alert-info d-none"></div>
                    <div id="resetErr" class="alert alert-danger d-none"></div>

                    <form id="resetForm">
                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <input id="newPassword" class="form-control form-control-lg" type="password" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Confirm Password</label>
                            <input id="confirmPassword" class="form-control form-control-lg" type="password" required />
                        </div>
                        <div class="form-text mb-3">
                            Password must be at least 8 characters, include 1 uppercase letter, and 1 number
                        </div>
                        <button class="btn btn-danger btn-lg w-100" type="submit" id="resetBtn">Reset Password</button>
                    </form>
                </div>

                <p id="noSelectionMsg" class="text-muted mb-0">Search and select a user first</p>
            </div>
        </div>
    </div>
</div>

<script>
    let selectedUserId = 0;

    document.getElementById('searchForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const q = document.getElementById('searchInput').value;
        const msg = document.getElementById('searchMsg');
        const err = document.getElementById('searchErr');
        msg.classList.add('d-none');
        err.classList.add('d-none');

        const res = await fetch('/api/admin/users/search?q=' + encodeURIComponent(q));
        const data = await res.json();

        if (!res.ok) {
            err.textContent = data.error || 'Search failed.';
            err.classList.remove('d-none');
            document.getElementById('resultsCard').classList.add('d-none');
            return;
        }

        if (data.length === 0) {
            msg.textContent = 'No users found.';
            msg.classList.remove('d-none');
            document.getElementById('resultsCard').classList.add('d-none');
            return;
        }

        document.getElementById('usersTableBody').innerHTML = data.map(u => `
            <tr class="hover-option">
                <td>${u.fullName}</td>
                <td>${u.eMail}</td>
                <td>${u.role}</td>
                <td><button class="btn btn-outline-light btn-sm" onclick="selectUser(${u.userId}, '${u.fullName}')">Select</button></td>
            </tr>`).join('');
        document.getElementById('resultsCard').classList.remove('d-none');
    });

    function selectUser(id, name) {
        selectedUserId = id;
        document.getElementById('selectedAlert').textContent = 'Selected: ' + name + ' (ID: ' + id + ')';
        document.getElementById('selectedInfo').classList.remove('d-none');
        document.getElementById('noSelectionMsg').classList.add('d-none');
        document.getElementById('resetSuccess').classList.add('d-none');
        document.getElementById('resetErr').classList.add('d-none');
    }

    document.getElementById('resetForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const success = document.getElementById('resetSuccess');
        const err = document.getElementById('resetErr');
        const btn = document.getElementById('resetBtn');
        success.classList.add('d-none');
        err.classList.add('d-none');
        btn.disabled = true;

        try {
            const res = await fetch('/api/admin/users/' + selectedUserId + '/reset-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    newPassword: document.getElementById('newPassword').value,
                    confirmPassword: document.getElementById('confirmPassword').value
                })
            });
            if (res.ok) {
                success.textContent = 'Password reset successfully.';
                success.classList.remove('d-none');
                document.getElementById('resetForm').reset();
            } else {
                const data = await res.json();
                err.textContent = data.error || 'Failed to reset password.';
                err.classList.remove('d-none');
            }
        } finally {
            btn.disabled = false;
        }
    });
</script>
