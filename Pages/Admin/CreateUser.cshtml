@page
@model student_online_system.Pages.Admin.CreateUserModel
@{
    ViewData["Title"] = "Create User";
}

<div class="container" style="max-width:780px;">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h3 class="mb-1">Create User</h3>
            <p class="text-muted">Create student or instructor accounts (Admin only)</p>

            <div id="msgAlert" class="alert alert-info d-none"></div>
            <div id="errorAlert" class="alert alert-danger d-none"></div>

            <form id="createForm" class="mt-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Full Name</label>
                        <input id="fullName" class="form-control form-control-lg" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Role</label>
                        <select id="role" class="form-select form-select-lg" required>
                            <option value="Student">Student</option>
                            <option value="Instructor">Instructor</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input id="email" type="email" class="form-control form-control-lg" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Password</label>
                        <input id="password" type="password" class="form-control form-control-lg" required />
                    </div>
                    <div class="col-12">
                        <button class="btn btn-danger btn-lg" type="submit" id="createBtn">Create</button>
                        <a class="btn btn-outline-light btn-lg ms-2" href="/Admin/Dashboard">Back</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById('createForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const msg = document.getElementById('msgAlert');
        const err = document.getElementById('errorAlert');
        const btn = document.getElementById('createBtn');
        msg.classList.add('d-none');
        err.classList.add('d-none');
        btn.disabled = true;

        try {
            const res = await fetch('/api/admin/users', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    fullName: document.getElementById('fullName').value,
                    email: document.getElementById('email').value,
                    password: document.getElementById('password').value,
                    role: document.getElementById('role').value
                })
            });

            if (res.ok) {
                msg.textContent = 'User created successfully.';
                msg.classList.remove('d-none');
                document.getElementById('createForm').reset();
            } else {
                const data = await res.json();
                err.textContent = data.error || 'Failed to create user.';
                err.classList.remove('d-none');
            }
        } catch {
            err.textContent = 'An error occurred.';
            err.classList.remove('d-none');
        } finally {
            btn.disabled = false;
        }
    });
</script>
